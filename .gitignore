# --- Crewe .gitignore (rename to .gitignore in the release repo) -------------
#
# Crewe writes its state to your HOME directory (~/crewe_users.json,
# ~/crewe_userdata/, ~/router_config.json ...), NOT to the checkout. So if you
# cloned into a subdirectory, none of this can be committed by accident.
#
# These entries matter when the repo IS your home directory, which is exactly
# how this project was developed — and they cost nothing otherwise. Add new
# state here the day you add the store, not the day you notice it in
# `git status`.

# --- credentials & secrets — NEVER commit -----------------------------------
crewe_users.json          # e-mail addresses + password hashes
crewe_secret              # session signing key; leaking it lets anyone forge a login
crewe_invites.json        # live single-use invite tokens
crewe_agent_hosts.json    # SSH targets: hostnames, usernames, key paths
router_config.json        # backend URLs AND API keys
.env

# --- per-user data — all of it personal -------------------------------------
crewe_userdata/           # docs, sheets, cookbook, uploads, chat memory, agent runs

# --- legacy single-user stores (pre-multi-tenancy; may still exist) ----------
router_memory.json
router_cookbook.json
router_prefs.md           # operator-set build standards, often personal
router_docs/
router_sheets/
router_books/
router_photos/
router_checks/
router_audio/

# --- runtime noise ----------------------------------------------------------
llama_logs/
llama_pids/
router_runs/
*.log

# --- backups & scratch ------------------------------------------------------
*.bak
*.bak-*
*.bak.*
router.py.bak*
*.damaged-*
*.part
*.tmp*

# --- python -----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- node (the pipeline's static-check helper) ------------------------------
node_modules/
package-lock.json

# --- models & caches --------------------------------------------------------
*.gguf
.cache/
